#version 450
#extension GL_EXT_scalar_block_layout : require
layout(local_size_x=1) in;
layout(set=0,binding=0) uniform usamplerBuffer source_values;
layout(r32ui,set=0,binding=1) uniform uimageBuffer output_values;
layout(std140,set=0,binding=2) uniform Parameters { uvec4 bias; } params;
layout(rgba8,set=0,binding=3) uniform image2D picture;
layout(scalar,set=0,binding=4) readonly buffer Scalars { float first; vec3 packed_vector; uint gain; } scalars;
void main() {
    uint i=gl_GlobalInvocationID.x;
    uint extra=uint(scalars.first+scalars.packed_vector.x+scalars.packed_vector.y+scalars.packed_vector.z)+scalars.gain;
    uint value=texelFetch(source_values,int(i)).x+params.bias.x+extra;
    imageStore(output_values,int(i),uvec4(value,0,0,0));
    imageStore(picture,ivec2(int(i)%8,int(i)/8),vec4(float(value&255u)/255.0,0.25,0.75,1.0));
}
