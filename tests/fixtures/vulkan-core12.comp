#version 450
#extension GL_KHR_shader_subgroup_ballot : require
layout(local_size_x=32) in;
layout(std430,binding=0) buffer Output { uint values[128]; float minimum; float maximum; float mirrored; } result;
layout(binding=1) uniform sampler2D min_image;
layout(binding=2) uniform sampler2D max_image;
layout(binding=3) uniform sampler2D mirror_image;
layout(push_constant) uniform Push { uint source_lane; } pc;
void main() {
    uint i=gl_GlobalInvocationID.x;
    result.values[i]=i+subgroupBroadcast(gl_SubgroupInvocationID+1,pc.source_lane);
    if(i==32){
        result.minimum=textureLod(min_image,vec2(0.5),0).r;
        result.maximum=textureLod(max_image,vec2(0.5),0).r;
        result.mirrored=textureLod(mirror_image,vec2(-0.75,0.25),0).r;
    }
}
