#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
layout(local_size_x=32) in;
layout(set=0,binding=0,std430) buffer Output {uint64_t buffer_sum;uint64_t shared_sum;} output_data;
shared uint64_t sum;
void main(){if(gl_LocalInvocationID.x==0)sum=0;barrier();atomicAdd(output_data.buffer_sum,uint64_t(3));atomicAdd(sum,uint64_t(3));barrier();if(gl_LocalInvocationID.x==0)atomicAdd(output_data.shared_sum,sum);}
