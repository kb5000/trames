#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) buffer Values { uint value[]; };
layout(push_constant) uniform Parameters { uint factor; } parameters;
void main() { uint i=gl_GlobalInvocationID.x; value[i]=value[i]*parameters.factor+7u; }
