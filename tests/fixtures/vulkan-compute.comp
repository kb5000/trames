#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) buffer Values { uint value[]; };
layout(push_constant) uniform Parameters { uint factor; } parameters;
layout(constant_id=0) const uint bias=7u;
layout(constant_id=1) const uint scale=1u;
void main() { uint i=gl_GlobalInvocationID.x; value[i]=(value[i]*parameters.factor+bias)*scale; }
