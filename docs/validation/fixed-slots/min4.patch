+// Only the block entry/exit uses a normal call. The pure micro-operations
+// have a separate six-argument tail ABI; ordinary instruction handlers stay
+// unchanged. No guest memory operation is included in this prepared block.
+#[inline(never)]
+extern "rust-preserve-none" fn tail_fixed<M: CpuMemory>(
+    state: &mut TailState<'_, M>,
+    slot: usize,
+    executed: u64,
+) -> TailExit {
+    // SAFETY: tail_next masks the slot and dispatches the exact immutable Op.
+    let entry = unsafe { state.page.instructions.get_unchecked(slot) };
+    let Op::Fixed { index } = entry.instruction.op else {
+        unsafe { std::hint::unreachable_unchecked() }
+    };
+    // SAFETY: only prepare installs an index, after inserting its block. Page
+    // invalidation clears both entries' generation and the derived blocks.
+    let block = unsafe { state.page.fixed.blocks.get_unchecked(index as usize) };
+    let count = if state.budget - executed >= block.count as u64 {
+        block.run(state.cpu);
+        block.count as u64
+    } else {
+        // A partial budget sees the exact original first instruction, including
+        // writes eliminated in the full block. Interior entries remain intact.
+        state.cpu.condition_flags = *state.flags;
+        let result = state.cpu.execute_instruction(block.first, state.memory);
+        *state.flags = state.cpu.condition_flags;
+        match result {
+            Ok(Event::Continue) => 1,
+            Err(error) => return TailExit::Stop(state.cpu.slice_fault(error, executed)),
+            _ => unreachable!("pure validated block instruction"),
+        }
+    };
+    let executed = executed.wrapping_add(count);
+    tail_next!(state, executed)
+}
