+// SPDX-License-Identifier: GPL-3.0-or-later
+// Generated by the fixed-slot experiment: each factory runs at preparation.
+use super::*;
+pub(super) fn constant<const O: u8>(p: &Plan) -> Handler {
+    if p.wide {
+        constant_d::<O, true>(p)
+    } else {
+        constant_d::<O, false>(p)
+    }
+}
+fn constant_d<const O: u8, const W: bool>(p: &Plan) -> Handler {
+    let handlers: [Handler; 4] = [
+        step::<O, W, 0, 0, 0, 0>,
+        step::<O, W, 1, 0, 0, 0>,
+        step::<O, W, 2, 0, 0, 0>,
+        step::<O, W, 3, 0, 0, 0>,
+    ];
+    handlers[p.d as usize]
+}
+pub(super) fn unary<const O: u8>(p: &Plan) -> Handler {
+    if p.wide {
+        unary_d::<O, true>(p)
+    } else {
+        unary_d::<O, false>(p)
+    }
+}
+fn unary_d<const O: u8, const W: bool>(p: &Plan) -> Handler {
+    match p.d {
+        0 => unary_a::<O, W, 0>(p),
+        1 => unary_a::<O, W, 1>(p),
+        2 => unary_a::<O, W, 2>(p),
+        3 => unary_a::<O, W, 3>(p),
+        _ => unreachable!("prepared physical slot"),
+    }
+}
+fn unary_a<const O: u8, const W: bool, const D: usize>(p: &Plan) -> Handler {
+    let handlers: [Handler; 4] = [
+        step::<O, W, D, 0, 0, 0>,
+        step::<O, W, D, 1, 0, 0>,
+        step::<O, W, D, 2, 0, 0>,
+        step::<O, W, D, 3, 0, 0>,
+    ];
+    handlers[p.a as usize]
+}
+pub(super) fn binary<const O: u8>(p: &Plan) -> Handler {
+    if p.wide {
+        binary_d::<O, true>(p)
+    } else {
+        binary_d::<O, false>(p)
+    }
+}
+fn binary_d<const O: u8, const W: bool>(p: &Plan) -> Handler {
+    match p.d {
+        0 => binary_a::<O, W, 0>(p),
+        1 => binary_a::<O, W, 1>(p),
+        2 => binary_a::<O, W, 2>(p),
+        3 => binary_a::<O, W, 3>(p),
+        _ => unreachable!("prepared physical slot"),
+    }
+}
+fn binary_a<const O: u8, const W: bool, const D: usize>(p: &Plan) -> Handler {
+    match p.a {
+        0 => binary_b::<O, W, D, 0>(p),
+        1 => binary_b::<O, W, D, 1>(p),
+        2 => binary_b::<O, W, D, 2>(p),
+        3 => binary_b::<O, W, D, 3>(p),
+        _ => unreachable!("prepared physical slot"),
+    }
+}
+fn binary_b<const O: u8, const W: bool, const D: usize, const A: usize>(p: &Plan) -> Handler {
+    let handlers: [Handler; 4] = [
+        step::<O, W, D, A, 0, 0>,
+        step::<O, W, D, A, 1, 0>,
+        step::<O, W, D, A, 2, 0>,
+        step::<O, W, D, A, 3, 0>,
+    ];
+    handlers[p.b as usize]
+}
+pub(super) fn ternary<const O: u8>(p: &Plan) -> Handler {
+    if p.wide {
+        ternary_d::<O, true>(p)
+    } else {
+        ternary_d::<O, false>(p)
+    }
+}
+fn ternary_d<const O: u8, const W: bool>(p: &Plan) -> Handler {
+    match p.d {
+        0 => ternary_a::<O, W, 0>(p),
+        1 => ternary_a::<O, W, 1>(p),
+        2 => ternary_a::<O, W, 2>(p),
+        3 => ternary_a::<O, W, 3>(p),
+        _ => unreachable!("prepared physical slot"),
+    }
+}
+fn ternary_a<const O: u8, const W: bool, const D: usize>(p: &Plan) -> Handler {
+    match p.a {
+        0 => ternary_b::<O, W, D, 0>(p),
+        1 => ternary_b::<O, W, D, 1>(p),
+        2 => ternary_b::<O, W, D, 2>(p),
+        3 => ternary_b::<O, W, D, 3>(p),
+        _ => unreachable!("prepared physical slot"),
+    }
+}
+fn ternary_b<const O: u8, const W: bool, const D: usize, const A: usize>(p: &Plan) -> Handler {
+    match p.b {
+        0 => ternary_c::<O, W, D, A, 0>(p),
+        1 => ternary_c::<O, W, D, A, 1>(p),
+        2 => ternary_c::<O, W, D, A, 2>(p),
+        3 => ternary_c::<O, W, D, A, 3>(p),
+        _ => unreachable!("prepared physical slot"),
+    }
+}
+fn ternary_c<const O: u8, const W: bool, const D: usize, const A: usize, const B: usize>(
+    p: &Plan,
+) -> Handler {
+    let handlers: [Handler; 4] = [
+        step::<O, W, D, A, B, 0>,
+        step::<O, W, D, A, B, 1>,
+        step::<O, W, D, A, B, 2>,
+        step::<O, W, D, A, B, 3>,
+    ];
+    handlers[p.c as usize]
+}
diff --git a/crates/trames-cpu/src/cached/fixed/tests.rs b/crates/trames-cpu/src/cached/fixed/tests.rs
new file mode 100644
index 0000000..c454f57
--- /dev/null
+++ b/crates/trames-cpu/src/cached/fixed/tests.rs
@@ -0,0 +1,282 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use super::*;
+use crate::{DecodeStats, SliceOutcome};
+use trames_memory::{Memory, Permissions, PAGE_SIZE};
+
+fn hot(words: &[u32]) -> (Cpu, Memory) {
+    let mut memory = Memory::default();
+    memory
+        .map(
+            0x1000,
+            PAGE_SIZE * 2,
+            Permissions {
+                read: true,
+                write: true,
+                execute: true,
+            },
+        )
+        .unwrap();
+    for (i, word) in words.iter().enumerate() {
+        memory
+            .write_array(0x1000 + i as u64 * 4, word.to_le_bytes())
+            .unwrap();
+    }
+    let mut cpu = Cpu::new(0x1000, 0x2ff0);
+    cpu.run_slice(&mut memory, 1);
+    let page = cpu
+        .decoded
+        .slots
+        .iter_mut()
+        .flatten()
+        .find(|p| p.base == 0x1000)
+        .unwrap();
+    for slot in 0..words.len() {
+        page.decode_slot(
+            &memory,
+            slot,
+            0x1000 + slot as u64 * 4,
+            &mut DecodeStats::default(),
+        )
+        .unwrap();
+    }
+    page.fixed.visits = HOT_VISITS;
+    prepare(page);
+    cpu.pc = 0x1000;
+    (cpu, memory)
+}
+
+fn equal(cpu: &Cpu, other: &Cpu) {
+    assert_eq!(cpu.registers, other.registers);
+    assert_eq!(
+        (cpu.pc, cpu.sp, cpu.nzcv()),
+        (other.pc, other.sp, other.nzcv())
+    );
+    assert_eq!(cpu.vectors, other.vectors);
+}
+
+#[test]
+fn fixed_slots_fold_dead_writes_and_keep_every_budget_and_interior_entry() {
+    let words = [
+        0x91001420, // add x0,x1,#5
+        0x91001c00, // add x0,x0,#7
+        0x91002402, // add x2,x0,#9
+        0xd2800083, // mov x3,#4
+        0xd28000a3, // mov x3,#5
+        0xd4000001,
+    ];
+    for entry in 0..words.len() {
+        for budget in 0..=words.len() as u64 + 1 {
+            let (mut cpu, mut memory) = hot(&words);
+            let page = cpu
+                .decoded
+                .slots
+                .iter()
+                .flatten()
+                .find(|p| p.base == 0x1000)
+                .unwrap();
+            let block = &page.fixed.blocks[0];
+            assert_eq!(block.count, 5);
+            assert_eq!(block.steps.len(), 4); // folded add, dependent add, constant, finish
+            assert_eq!(block.input.count_ones(), 1);
+            cpu.pc = 0x1000 + entry as u64 * 4;
+            cpu.set_x(1, u64::MAX - 10);
+            cpu.set_nzcv(11);
+            let mut other = cpu.clone();
+            let mut reference = memory.clone();
+            assert_eq!(
+                format!("{:?}", cpu.run_slice(&mut memory, budget)),
+                format!("{:?}", other.run_reference(&mut reference, budget))
+            );
+            equal(&cpu, &other);
+        }
+    }
+}
+
+#[test]
+fn fixed_slots_cover_width_roles_multiply_and_bitfield_overlap() {
+    // Four architectural registers, with every source/destination overlap.
+    // The block marker is verified, so these are not merely fallback tests.
+    let operations = [
+        0x0b020020, 0x4b020020, // add/sub, unshifted
+        0x0b025420, 0x4b025420, // add/sub, lsl #21
+        0x0a020020, 0x2a020020, 0x4a020020, // and/orr/eor
+        0x0a220020, 0x2a220020, 0x4a220020, // bic/orn/eon
+        0x2a0103e0, // mov alias, ZR source
+        0x1b020c20, 0x1b028c20, // madd/msub
+        0x1b027c20, 0x1b02fc20, // mul/mneg
+        0x53075420, 0x13075420, 0x33075420, // ubfm/sbfm/bfm, r=7,s=21
+        0x72824680, // movk, preserves destination bits
+    ];
+    for base in operations {
+        for wide in [false, true] {
+            let mut base = base | if wide { 1 << 31 } else { 0 };
+            if wide && base & 0x1f800000 == 0x13000000 {
+                base |= 1 << 22;
+            }
+            for d in 0..4u32 {
+                for a in 0..4u32 {
+                    for b in 0..4u32 {
+                        let mut word = (base & !31) | d;
+                        if base & 0x1f800000 != 0x12800000 {
+                            if base & 0x1f000000 != 0x0a000000 || base & (31 << 5) != 31 << 5 {
+                                word = (word & !(31 << 5)) | (a << 5);
+                            }
+                            if base & 0x1f800000 != 0x13000000 {
+                                word = (word & !(31 << 16)) | (b << 16);
+                            }
+                        }
+                        // Arithmetic plus two NOPs reaches the four-word threshold.
+                        // The tested operation is not made constant.
+                        let (mut cpu, mut memory) = hot(&[
+                            word,
+                            0x91000400 | d | (d << 5),
+                            0xd503201f,
+                            0xd503201f,
+                            0xd4000001,
+                        ]);
+                        assert!(
+                            cpu.decoded
+                                .slots
+                                .iter()
+                                .flatten()
+                                .any(|p| !p.fixed.blocks.is_empty()),
+                            "{word:08x}"
+                        );
+                        for seed in [0, u64::MAX, 0x8000000080000000] {
+                            cpu.pc = 0x1000;
+                            for r in 0..4 {
+                                cpu.set_x(r, seed.wrapping_add(r as u64 * 0x12345));
+                            }
+                            cpu.set_nzcv(9);
+                            let mut other = cpu.clone();
+                            let mut reference = memory.clone();
+                            assert_eq!(
+                                format!("{:?}", cpu.run_slice(&mut memory, 5)),
+                                format!("{:?}", other.run_reference(&mut reference, 5)),
+                                "{word:08x}"
+                            );
+                            equal(&cpu, &other);
+                        }
+                    }
+                }
+            }
+        }
+    }
+    for words in [
+        [0x91001c1f, 0x91000fe2, 0x910007ff, 0xd503201f, 0xd4000001], // SP dest/source
+        [0xaa1f03e0, 0x91000401, 0xaa0103ff, 0xd503201f, 0xd4000001], // zero source/discard
+        [0x11001420, 0x91001c00, 0x11002400, 0xd503201f, 0xd4000001], // mixed W/X, no add folding
+        [0xd2800020, 0xf2e00020, 0xf2a00020, 0xd503201f, 0xd4000001], // constant propagation through MOVK
+    ] {
+        for budget in 0..=6 {
+            let (mut cpu, mut memory) = hot(&words);
+            cpu.set_x(0, u64::MAX);
+            cpu.set_x(1, u64::MAX);
+            cpu.set_nzcv(7);
+            let mut other = cpu.clone();
+            let mut reference = memory.clone();
+            assert_eq!(
+                format!("{:?}", cpu.run_slice(&mut memory, budget)),
+                format!("{:?}", other.run_reference(&mut reference, budget))
+            );
+            equal(&cpu, &other);
+        }
+    }
+}
+
+#[test]
+fn fixed_slots_publish_before_fault_and_revalidate_code_and_generations() {
+    let (mut cpu, mut memory) = hot(&[0x91001420, 0x91001c00, 0xd503201f, 0xd503201f, 0xf9400122]);
+    cpu.set_x(1, 7);
+    cpu.set_x(9, 0x9000);
+    let mut other = cpu.clone();
+    let mut reference = memory.clone();
+    assert_eq!(
+        format!("{:?}", cpu.run_slice(&mut memory, 5)),
+        format!("{:?}", other.run_reference(&mut reference, 5))
+    );
+    equal(&cpu, &other);
+    assert_eq!(cpu.x(0), 19);
+    assert_eq!(cpu.pc, 0x1010);
+    assert_eq!(cpu.fault_retired(), 4);
+    // Rewrite an interior instruction through a shared address space.
+    memory
+        .share()
+        .write_array(0x1004, 0xd4000001u32.to_le_bytes())
+        .unwrap();
+    cpu.pc = 0x1000;
+    assert!(matches!(
+        cpu.run_slice(&mut memory, 3),
+        SliceOutcome::Syscall { instructions: 2 }
+    ));
+    assert_eq!(cpu.x(0), 12);
+    // The same page generation must never resurrect a removed prepared block.
+    let page = cpu
+        .decoded
+        .slots
+        .iter_mut()
+        .flatten()
+        .find(|p| p.base == 0x1000)
+        .unwrap();
+    page.generation = u64::MAX;
+    page.instructions[0].generation = u64::MAX;
+    memory
+        .write_array(0x1000, 0xd2800100u32.to_le_bytes())
+        .unwrap();
+    cpu.pc = 0x1000;
+    cpu.run_slice(&mut memory, 1);
+    assert_eq!(cpu.x(0), 8);
+    let page = cpu
+        .decoded
+        .slots
+        .iter()
+        .flatten()
+        .find(|p| p.base == 0x1000)
+        .unwrap();
+    assert_eq!(page.generation, 1);
+    assert!(page.fixed.blocks.is_empty());
+    memory.protect(0x1000, PAGE_SIZE, Permissions::RW).unwrap();
+    cpu.pc = 0x1000;
+    assert!(matches!(
+        cpu.run_slice(&mut memory, 1),
+        SliceOutcome::Fault(_)
+    ));
+}
+
+#[test]
+fn fixed_slots_bound_metadata_and_stop_when_a_fifth_register_is_needed() {
+    let (cpu, _) = hot(&[0x8b020020, 0x8b040063, 0xd4000001]);
+    assert!(cpu
+        .decoded
+        .slots
+        .iter()
+        .flatten()
+        .all(|p| p.fixed.blocks.is_empty()));
+    // Short regions stay on the ordinary instruction path.
+    let (short, _) = hot(&[0x91000400, 0x91000400, 0x91000400, 0xd4000001]);
+    assert!(short
+        .decoded
+        .slots
+        .iter()
+        .flatten()
+        .all(|p| p.fixed.blocks.is_empty()));
+    let mut words = Vec::new();
+    for _ in 0..MAX_BLOCKS + 2 {
+        words.extend([0x91000400, 0x91000400, 0x91000400, 0x91000400, 0xd4000001]);
+    }
+    let (cpu, _) = hot(&words);
+    let page = cpu
+        .decoded
+        .slots
+        .iter()
+        .flatten()
+        .find(|p| p.base == 0x1000)
+        .unwrap();
+    assert_eq!(page.fixed.blocks.len(), MAX_BLOCKS);
+    assert!(page.fixed.pending.capacity() <= PAGE_WORDS);
+    assert!(page
+        .fixed
+        .blocks
+        .iter()
+        .all(|b| b.count as usize <= MAX_INSTRUCTIONS && b.steps.len() <= MAX_INSTRUCTIONS + 1));
+}
