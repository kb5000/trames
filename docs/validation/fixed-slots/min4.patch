+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Prepared pure integer blocks with four statically routed scalar operands.
+//! Preparation produces data and pointers to precompiled Rust functions only.
+use super::{CodePage, Cpu, Instruction, Op, PAGE_WORDS};
+
+mod select;
+#[cfg(test)]
+mod tests;
+
+pub(super) const MAX_INSTRUCTIONS: usize = 16;
+const MAX_BLOCKS: usize = 128;
+const MIN_INSTRUCTIONS: usize = 4;
+const HOT_VISITS: u16 = 64;
+const UNUSED: u8 = 255;
+const ZERO: u8 = 32;
+const CONSTANT: u8 = 0;
+const COPY: u8 = 1;
+const KEEP: u8 = 2;
+const ADD_IMM: u8 = 3;
+const ADD_SHIFT: u8 = 4;
+const SUB_SHIFT: u8 = 5;
+const AND_SHIFT: u8 = 6;
+const OR_SHIFT: u8 = 7;
+const XOR_SHIFT: u8 = 8;
+const BIC_SHIFT: u8 = 9;
+const ORN_SHIFT: u8 = 10;
+const EON_SHIFT: u8 = 11;
+const AND_IMM: u8 = 12;
+const OR_IMM: u8 = 13;
+const XOR_IMM: u8 = 14;
+const UBFM: u8 = 15;
+const SBFM: u8 = 16;
+const BFM: u8 = 17;
+const MUL: u8 = 18;
+const MADD: u8 = 19;
+const MSUB: u8 = 20;
+const NEG_MUL: u8 = 21;
+
+#[derive(Clone, Copy, Debug, Default)]
+struct Params {
+    value: u64,
+    mask: u64,
+    shift: u8,
+    bit: u8,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Plan {
+    op: u8,
+    wide: bool,
+    d: u8,
+    a: u8,
+    b: u8,
+    c: u8,
+    params: Params,
+}
+
+const fn arity(op: u8) -> usize {
+    match op {
+        CONSTANT => 0,
+        COPY | KEEP | ADD_IMM | AND_IMM | OR_IMM | XOR_IMM | UBFM | SBFM => 1,
+        MADD | MSUB => 3,
+        _ => 2,
+    }
+}
+
+impl Plan {
+    fn inputs(self) -> [u8; 3] {
+        [self.a, self.b, self.c]
+    }
+    fn reads(self) -> u8 {
+        self.inputs()[..arity(self.op)]
+            .iter()
+            .fold(0, |mask, &slot| mask | (1 << slot))
+    }
+    fn constant(self, values: &[Option<u64>; 4]) -> Option<u64> {
+        let mut args = [0; 3];
+        for (i, &slot) in self.inputs()[..arity(self.op)].iter().enumerate() {
+            args[i] = values[slot as usize]?;
+        }
+        macro_rules! fold {
+            ($($op:ident),+) => { match self.op {
+                $($op => if self.wide {
+                    evaluate::<$op, true>(args[0], args[1], args[2], &self.params)
+                } else {
+                    evaluate::<$op, false>(args[0], args[1], args[2], &self.params)
+                },)+
+                _ => unreachable!("prepared operation"),
+            }};
+        }
+        Some(fold!(
+            CONSTANT, COPY, KEEP, ADD_IMM, ADD_SHIFT, SUB_SHIFT, AND_SHIFT, OR_SHIFT, XOR_SHIFT,
+            BIC_SHIFT, ORN_SHIFT, EON_SHIFT, AND_IMM, OR_IMM, XOR_IMM, UBFM, SBFM, BFM, MUL, MADD,
+            MSUB, NEG_MUL
+        ))
+    }
+    fn handler(self) -> Handler {
+        match self.op {
+            CONSTANT => select::constant::<CONSTANT>(&self),
+            COPY => select::unary::<COPY>(&self),
+            KEEP => select::unary::<KEEP>(&self),
+            ADD_IMM => select::unary::<ADD_IMM>(&self),
+            ADD_SHIFT => select::binary::<ADD_SHIFT>(&self),
+            SUB_SHIFT => select::binary::<SUB_SHIFT>(&self),
+            AND_SHIFT => select::binary::<AND_SHIFT>(&self),
+            OR_SHIFT => select::binary::<OR_SHIFT>(&self),
+            XOR_SHIFT => select::binary::<XOR_SHIFT>(&self),
+            BIC_SHIFT => select::binary::<BIC_SHIFT>(&self),
+            ORN_SHIFT => select::binary::<ORN_SHIFT>(&self),
+            EON_SHIFT => select::binary::<EON_SHIFT>(&self),
+            AND_IMM => select::unary::<AND_IMM>(&self),
+            OR_IMM => select::unary::<OR_IMM>(&self),
+            XOR_IMM => select::unary::<XOR_IMM>(&self),
+            UBFM => select::unary::<UBFM>(&self),
+            SBFM => select::unary::<SBFM>(&self),
+            BFM => select::binary::<BFM>(&self),
+            MUL => select::binary::<MUL>(&self),
+            NEG_MUL => select::binary::<NEG_MUL>(&self),
+            MADD => select::ternary::<MADD>(&self),
+            MSUB => select::ternary::<MSUB>(&self),
+            _ => unreachable!("prepared operation"),
+        }
+    }
+}
+
+fn guest(index: u8, sp: bool) -> u8 {
+    if index == 31 && !sp {
+        ZERO
+    } else {
+        index
+    }
+}
+
+/// Guest register identities are 0..30, SP=31, ZR=32. No flag producer,
+/// branch, memory instruction, native entry or faulting operation is admitted.
+pub(super) fn lower(ins: Instruction, pc: u64) -> Option<Plan> {
+    let mut p = Plan {
+        op: CONSTANT,
+        wide: ins.wide,
+        d: guest(ins.rd.0, false),
+        a: guest(ins.rn.0, false),
+        b: guest(ins.rm.0, false),
+        c: ZERO,
+        params: Params::default(),
+    };
+    match ins.op {
+        Op::Nop => p.d = ZERO,
+        Op::Move { opc: 0, value, .. } => p.params.value = !value,
+        Op::Move { opc: 2, value, .. } => p.params.value = value,
+        Op::Move {
+            opc: 3,
+            shift,
+            value,
+        } => {
+            p.op = KEEP;
+            p.a = p.d;
+            p.params = Params {
+                value,
+                mask: !(0xffffu64 << shift),
+                ..Params::default()
+            };
+        }
+        Op::Address { immediate } => {
+            p.params.value = if ins.wide {
+                (pc & !4095).wrapping_add(immediate << 12)
+            } else {
+                pc.wrapping_add(immediate)
+            };
+            p.wide = true;
+        }
+        Op::AddImmediate { value } => {
+            p.op = ADD_IMM;
+            p.params.value = value;
+            p.d = guest(ins.rd.0, true);
+            p.a = guest(ins.rn.0, true);
+        }
+        Op::AddShift {
+            sub,
+            flags: false,
+            kind: 0,
+            amount,
+        } => {
+            p.op = if sub { SUB_SHIFT } else { ADD_SHIFT };
+            p.params.shift = amount;
+        }
+        Op::LogicalShift {
+            opc: opc @ 0..=2,
+            invert,
+            kind: 0,
+            amount,
+        } => {
+            if opc == 1 && !invert && amount == 0 && ins.rn.0 == 31 {
+                p.op = COPY;
+                p.a = p.b;
+            } else {
+                p.op = [AND_SHIFT, OR_SHIFT, XOR_SHIFT][opc as usize] + if invert { 3 } else { 0 };
+                p.params.shift = amount;
+            }
+        }
+        Op::LogicalImmediate {
+            opc: opc @ 0..=2,
+            value,
+        } => {
+            p.op = [AND_IMM, OR_IMM, XOR_IMM][opc as usize];
+            p.params.value = value;
+            p.d = guest(ins.rd.0, true);
+        }
+        Op::Bitfield {
+            opc,
+            r,
+            s,
+            wmask,
+            tmask,
+        } => {
+            p.op = match opc {
+                0 => SBFM,
+                1 => BFM,
+                _ => UBFM,
+            };
+            p.b = p.d;
+            p.params = Params {
+                value: tmask,
+                mask: wmask & tmask,
+                shift: r,
+                bit: s,
+            };
+        }
+        Op::Multiply { kind: 0, ra, sub } => {
+            p.op = if ra.0 == 31 {
+                if sub {
+                    NEG_MUL
+                } else {
+                    MUL
+                }
+            } else if sub {
+                MSUB
+            } else {
+                MADD
+            };
+            p.c = guest(ra.0, false);
+        }
+        _ => return None,
+    }
+    Some(p)
+}
+
+#[inline(always)]
+fn evaluate<const O: u8, const W: bool>(a: u64, b: u64, c: u64, p: &Params) -> u64 {
+    let mask = super::width_mask(W);
+    let shifted = if W {
+        b.wrapping_shl(p.shift as u32)
+    } else {
+        (b as u32).wrapping_shl(p.shift as u32) as u64
+    };
+    let rotated = if W {
+        a.rotate_right(p.shift as u32)
+    } else {
+        (a as u32).rotate_right(p.shift as u32) as u64
+    };
+    (match O {
+        CONSTANT => p.value,
+        COPY => a,
+        KEEP => (a & p.mask) | p.value,
+        ADD_IMM => a.wrapping_add(p.value),
+        ADD_SHIFT => a.wrapping_add(shifted),
+        SUB_SHIFT => a.wrapping_sub(shifted),
+        AND_SHIFT => a & shifted,
+        OR_SHIFT => a | shifted,
+        XOR_SHIFT => a ^ shifted,
+        BIC_SHIFT => a & !shifted,
+        ORN_SHIFT => a | !shifted,
+        EON_SHIFT => a ^ !shifted,
+        AND_IMM => a & p.value,
+        OR_IMM => a | p.value,
+        XOR_IMM => a ^ p.value,
+        UBFM => rotated & p.mask,
+        SBFM => {
+            let top = if a & (1 << p.bit) != 0 { mask } else { 0 };
+            (top & !p.value) | (rotated & p.mask)
+        }
+        BFM => (b & !p.mask) | (rotated & p.mask),
+        MUL => a.wrapping_mul(b),
+        NEG_MUL => a.wrapping_mul(b).wrapping_neg(),
+        MADD => c.wrapping_add(a.wrapping_mul(b)),
+        MSUB => c.wrapping_sub(a.wrapping_mul(b)),
+        _ => unreachable!("static operation"),
+    }) & mask
+}
+
+type Handler =
+    for<'a, 'b> extern "rust-preserve-none" fn(&'a mut State<'b>, *const Micro, u64, u64, u64, u64);
+
+#[derive(Debug)]
+struct Micro {
+    params: Params,
+    handler: Handler,
+}
+
+struct State<'a> {
+    cpu: &'a mut Cpu,
+    block: &'a Block,
+}
+
+#[derive(Debug)]
+pub(super) struct Block {
+    pub(super) first: u32,
+    pub(super) count: u8,
+    registers: [u8; 4],
+    input: u8,
+    dirty: u8,
+    steps: Box<[Micro]>,
+}
+
+#[inline(always)]
+fn pick<const I: usize>(r0: u64, r1: u64, r2: u64, r3: u64) -> u64 {
+    match I {
+        0 => r0,
+        1 => r1,
+        2 => r2,
+        3 => r3,
+        _ => unreachable!("static slot"),
+    }
+}
+
+#[inline(never)]
+extern "rust-preserve-none" fn step<
+    const O: u8,
+    const W: bool,
+    const D: usize,
+    const A: usize,
+    const B: usize,
+    const C: usize,
+>(
+    state: &mut State<'_>,
+    ip: *const Micro,
+    r0: u64,
+    r1: u64,
+    r2: u64,
+    r3: u64,
+) {
+    // SAFETY: build appends one finish sentinel to an immutable allocation.
+    // run starts at its first element; each real handler advances exactly one
+    // element, and finish returns without advancing. No guest-controlled host
+    // pointer or callback participates in this finite chain.
+    let (value, next, handler) = unsafe {
+        let value = evaluate::<O, W>(
+            pick::<A>(r0, r1, r2, r3),
+            pick::<B>(r0, r1, r2, r3),
+            pick::<C>(r0, r1, r2, r3),
+            &(*ip).params,
+        );
+        let next = ip.add(1);
+        (value, next, (*next).handler)
+    };
+    become handler(
+        state,
+        next,
+        if D == 0 { value } else { r0 },
+        if D == 1 { value } else { r1 },
+        if D == 2 { value } else { r2 },
+        if D == 3 { value } else { r3 },
+    );
+}
+
+#[inline(never)]
+extern "rust-preserve-none" fn finish(
+    state: &mut State<'_>,
+    _ip: *const Micro,
+    r0: u64,
+    r1: u64,
+    r2: u64,
+    r3: u64,
+) {
+    for (slot, value) in [r0, r1, r2, r3].into_iter().enumerate() {
+        if state.block.dirty & (1 << slot) != 0 {
+            let reg = state.block.registers[slot];
+            if reg == 31 {
+                state.cpu.sp = value;
+            } else {
+                state.cpu.set_x(reg as usize, value);
+            }
+        }
+    }
+}
+
+impl Block {
+    #[inline(always)]
+    pub(super) fn run(&self, cpu: &mut Cpu) {
+        let mut values = [0; 4];
+        for (slot, value) in values.iter_mut().enumerate() {
+            if self.input & (1 << slot) != 0 {
+                *value = match self.registers[slot] {
+                    31 => cpu.sp,
+                    ZERO => 0,
+                    reg => cpu.x(reg as usize),
+                };
+            }
+        }
+        let mut state = State { cpu, block: self };
+        let first = &self.steps[0];
+        (first.handler)(
+            &mut state, first, values[0], values[1], values[2], values[3],
+        );
+        cpu.pc = cpu.pc.wrapping_add(self.count as u64 * 4);
+    }
+}
+
+#[derive(Debug, Default)]
+pub(super) struct Cache {
+    pub(super) blocks: Vec<Block>,
+    pending: Vec<u16>,
+    visits: u16,
+}
+impl Cache {
+    pub(super) fn clear(&mut self) {
+        self.blocks.clear();
+        self.pending.clear();
+        self.visits = 0;
+    }
+    pub(super) fn visit(&mut self) {
+        self.visits = self.visits.saturating_add(1).min(HOT_VISITS);
+    }
+    pub(super) fn pending(&mut self, end: usize) {
+        if self.blocks.len() < MAX_BLOCKS && self.pending.len() < PAGE_WORDS {
+            self.pending.push(end as u16);
+        }
+    }
+}
+
+fn physical(registers: &mut [u8; 4], guest: u8) -> Option<u8> {
+    if let Some(i) = registers.iter().position(|&reg| reg == guest) {
+        return Some(i as u8);
+    }
+    let i = registers.iter().position(|&reg| reg == UNUSED)?;
+    registers[i] = guest;
+    Some(i as u8)
+}
+
+fn build(page: &CodePage, start: usize, end: usize) -> (usize, Option<Block>) {
+    let mut registers = [UNUSED; 4];
+    let mut known = [None; 4];
+    let mut dirty = 0;
+    let mut plans: Vec<Plan> = Vec::new();
+    let mut count = 0;
+    for slot in start..end {
+        let ins = page.instructions[slot].instruction;
+        let Some(mut plan) = lower(ins, page.base + slot as u64 * 4) else {
+            break;
+        };
+        if plan.d == ZERO {
+            count += 1;
+            continue;
+        } // pure discarded write or NOP
+        let mut next_registers = registers;
+        let mut sources = [0; 3];
+        let mut fits = true;
+        for (i, &guest) in plan.inputs()[..arity(plan.op)].iter().enumerate() {
+            if let Some(index) = physical(&mut next_registers, guest) {
+                sources[i] = index;
+            } else {
+                fits = false;
+                break;
+            }
+        }
+        let dest = physical(&mut next_registers, plan.d);
+        if !fits || dest.is_none() {
+            break;
+        }
+        registers = next_registers;
+        for (i, &reg) in registers.iter().enumerate() {
+            if reg == ZERO {
+                known[i] = Some(0);
+            }
+        }
+        plan.d = dest.unwrap();
+        [plan.a, plan.b, plan.c] = sources;
+        dirty |= 1 << plan.d;
+        let value = plan.constant(&known);
+        known[plan.d as usize] = value;
+        if let Some(value) = value {
+            plan.op = CONSTANT;
+            plan.params.value = value;
+        } else if plan.op == ADD_IMM {
+            if let Some(previous) = plans.last() {
+                if previous.op == ADD_IMM
+                    && previous.wide == plan.wide
+                    && previous.d == plan.d
+                    && plan.a == plan.d
+                {
+                    plan.a = previous.a;
+                    plan.params.value = plan.params.value.wrapping_add(previous.params.value);
+                    plans.pop();
+                }
+            }
+        }
+        plans.push(plan);
+        count += 1;
+    }
+    if count < MIN_INSTRUCTIONS {
+        return (count.max(1), None);
+    }
+    // Every modified architectural register is observable at a full block exit.
+    // Partial budgets never enter this chain; the original instruction executes.
+    let mut live = dirty;
+    let mut keep = vec![false; plans.len()];
+    for (i, p) in plans.iter().enumerate().rev() {
+        if live & (1 << p.d) != 0 {
+            keep[i] = true;
+            live = (live & !(1 << p.d)) | p.reads();
+        }
+    }
+    let mut input = 0;
+    let mut defined = 0;
+    let mut steps = Vec::new();
+    for (p, keep) in plans.into_iter().zip(keep) {
+        if !keep {
+            continue;
+        }
+        input |= p.reads() & !defined;
+        defined |= 1 << p.d;
+        steps.push(Micro {
+            params: p.params,
+            handler: p.handler(),
+        });
+    }
+    steps.push(Micro {
+        params: Params::default(),
+        handler: finish,
+    });
+    (
+        count,
+        Some(Block {
+            first: page.instructions[start].instruction.word,
+            count: count as u8,
+            registers,
+            input,
+            dirty,
+            steps: steps.into_boxed_slice(),
+        }),
+    )
+}
+
+pub(super) fn prepare(page: &mut CodePage) {
+    if page.fixed.visits < HOT_VISITS || page.fixed.pending.is_empty() {
+        return;
+    }
+    // Reuse the pending allocation, with no per-instruction profiling updates.
+    let mut pending = std::mem::take(&mut page.fixed.pending);
+    for end in pending.drain(..) {
+        if page.fixed.blocks.len() == MAX_BLOCKS {
+            break;
+        }
+        let end = end as usize;
+        let mut start = end;
+        while start > end.saturating_sub(MAX_INSTRUCTIONS) {
+            let entry = &page.instructions[start - 1];
+            if entry.generation != page.generation
+                || lower(entry.instruction, page.base + (start as u64 - 1) * 4).is_none()
+            {
+                break;
+            }
+            start -= 1;
+        }
+        while start < end && page.fixed.blocks.len() < MAX_BLOCKS {
+            let (count, block) = build(page, start, end);
+            if let Some(block) = block {
+                let index = page.fixed.blocks.len() as u8;
+                page.fixed.blocks.push(block);
+                page.instructions[start].instruction.op = Op::Fixed { index };
+            }
+            start += count;
+        }
+    }
+    pending.clear();
+    page.fixed.pending = pending;
+}
