  "implementation": {
    "common_crate": "trames-kernel",
    "dependency_contract": "Common kernel/Linux exclude interpreter, accelerator and hardware/product transports. Mac uses common kernel/Linux plus HVF; iPad uses common kernel/Linux plus its existing interpreter.",
    "shared_state": [
      "Signal dispositions and worker query table",
      "Task/process pending queues, masks, precise synchronous-fault policy and siginfo/signalfd encoding",
      "Alternate stacks, frame depth, AArch64 signal entry/return and fork/exec signal-state inheritance",
      "Existing ready-queue affinity placement"
    ],
    "concurrency": "The existing object-local signal table mutex and owner-managed pending queues remain. No new coordinator/service thread, ordinary guest-access checks or hot-path barriers.",
    "architectural_boundary": "Core materializes deferred flags/registers only at signal entry/return. Decoder caches and normal interpreter state remain intact. Hardware uses the same Aarch64State and signal ABI.",
    "hardware_fixes": [
      "Classify alignment and other non-repairable aborts instead of repeatedly treating them as demand mappings.",
      "Route the sole task gettid consistently with getpid; explicit raw gettid previously returned ENOSYS."
    ]
  },
