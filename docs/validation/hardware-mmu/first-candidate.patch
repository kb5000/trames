+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Recover only our exact scalar memory instructions inside a live arena.
+use super::host::WINDOW;
+use std::sync::{
+    atomic::{AtomicBool, AtomicUsize, Ordering},
+    OnceLock,
+};
+
+const MAX_WINDOWS: usize = 2048;
+static WINDOWS: [AtomicUsize; MAX_WINDOWS] = [const { AtomicUsize::new(0) }; MAX_WINDOWS];
+static SEGV_RESET: AtomicBool = AtomicBool::new(false);
+static BUS_RESET: AtomicBool = AtomicBool::new(false);
+static STARTED: OnceLock<bool> = OnceLock::new();
+struct Previous {
+    segv: libc::sigaction,
+    bus: libc::sigaction,
+}
+static PREVIOUS: OnceLock<Previous> = OnceLock::new();
+
+pub(super) fn register(base: usize) -> Option<usize> {
+    WINDOWS.iter().position(|slot| {
+        slot.compare_exchange(0, base, Ordering::Release, Ordering::Relaxed)
+            .is_ok()
+    })
+}
+pub(super) fn unregister(slot: usize) {
+    WINDOWS[slot].store(0, Ordering::Release);
+}
+pub(super) fn install() -> bool {
+    *STARTED.get_or_init(|| {
+        // SAFETY: zero initializes sigsets/unused union fields; sigaction fills
+        // both saved dispositions before any arena or assembly access exists.
+        unsafe {
+            let (mut segv, mut bus): (libc::sigaction, libc::sigaction) = std::mem::zeroed();
+            if libc::sigaction(libc::SIGSEGV, std::ptr::null(), &mut segv) != 0
+                || libc::sigaction(libc::SIGBUS, std::ptr::null(), &mut bus) != 0
+            {
+                return false;
+            }
+            if PREVIOUS.set(Previous { segv, bus }).is_err() {
+                return false;
+            }
+            let mut action: libc::sigaction = std::mem::zeroed();
+            let previous = PREVIOUS.get().expect("saved signal dispositions");
+            action.sa_flags = libc::SA_SIGINFO
+                | libc::SA_ONSTACK
+                | (previous.segv.sa_flags & (libc::SA_NODEFER | libc::SA_RESTART));
+            action.sa_sigaction = handle as *const () as usize;
+            action.sa_mask = previous.segv.sa_mask;
+            if libc::sigaction(libc::SIGSEGV, &action, std::ptr::null_mut()) != 0 {
+                return false;
+            }
+            action.sa_flags = libc::SA_SIGINFO
+                | libc::SA_ONSTACK
+                | (previous.bus.sa_flags & (libc::SA_NODEFER | libc::SA_RESTART));
+            action.sa_mask = previous.bus.sa_mask;
+            if libc::sigaction(libc::SIGBUS, &action, std::ptr::null_mut()) != 0 {
+                libc::sigaction(
+                    libc::SIGSEGV,
+                    &PREVIOUS.get().unwrap().segv,
+                    std::ptr::null_mut(),
+                );
+                return false;
+            }
+            true
+        }
+    })
+}
+
+extern "C" fn handle(signal: i32, info: *mut libc::siginfo_t, context: *mut libc::c_void) {
+    // SAFETY: the kernel supplies this context and siginfo for SA_SIGINFO. No
+    // allocation, Rust panic, locks, TLS, longjmp or unwinding occurs here.
+    unsafe {
+        if !info.is_null() && !context.is_null() && (*info).si_code > 0 {
+            let address = (*info).si_addr() as usize;
+            let pc = context_pc(context);
+            if !pc.is_null() {
+                if let Some(recovery) = super::access::recovery(*pc) {
+                    if WINDOWS.iter().any(|slot| {
+                        let base = slot.load(Ordering::Acquire);
+                        base != 0 && address.wrapping_sub(base) < WINDOW
+                    }) {
+                        *pc = recovery;
+                        return;
+                    }
+                }
+            }
+        }
+        let Some(previous) = PREVIOUS.get() else {
+            libc::_exit(128 + signal);
+        };
+        let old = if signal == libc::SIGBUS {
+            &previous.bus
+        } else {
+            &previous.segv
+        };
+        if old.sa_sigaction == libc::SIG_IGN {
+            return;
+        }
+        let reset = if signal == libc::SIGBUS {
+            &BUS_RESET
+        } else {
+            &SEGV_RESET
+        };
+        let already_reset =
+            old.sa_flags & libc::SA_RESETHAND != 0 && reset.swap(true, Ordering::Relaxed);
+        if old.sa_sigaction == libc::SIG_DFL || already_reset {
+            let mut default: libc::sigaction = std::mem::zeroed();
+            default.sa_sigaction = libc::SIG_DFL;
+            libc::sigemptyset(&mut default.sa_mask);
+            libc::sigaction(signal, &default, std::ptr::null_mut());
+            libc::raise(signal);
+        } else if old.sa_flags & libc::SA_SIGINFO != 0 {
+            let callback: extern "C" fn(i32, *mut libc::siginfo_t, *mut libc::c_void) =
+                std::mem::transmute(old.sa_sigaction);
+            callback(signal, info, context);
+        } else {
+            let callback: extern "C" fn(i32) = std::mem::transmute(old.sa_sigaction);
+            callback(signal);
+        }
+    }
+}
+
+unsafe fn context_pc(context: *mut libc::c_void) -> *mut usize {
+    #[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+    // SAFETY: Linux's SA_SIGINFO ucontext matches this target's libc ABI.
+    unsafe {
+        (&raw mut (*(context.cast::<libc::ucontext_t>())).uc_mcontext.gregs[libc::REG_RIP as usize])
+            .cast()
+    }
+    #[cfg(all(target_os = "linux", target_arch = "aarch64"))]
+    unsafe {
+        (&raw mut (*(context.cast::<libc::ucontext_t>())).uc_mcontext.pc).cast()
+    }
+    #[cfg(target_vendor = "apple")]
+    // Public Darwin ucontext/mcontext prefixes. arm64e is not a build target;
+    // the x86_64 layout permits native development/CI on Intel Macs.
+    unsafe {
+        let context = &mut *context.cast::<DarwinContext>();
+        if context.machine.is_null() || context.size < std::mem::size_of::<DarwinMachine>() {
+            return std::ptr::null_mut();
+        }
+        (&raw mut (*context.machine).pc).cast()
+    }
+}
+#[cfg(target_vendor = "apple")]
+#[repr(C)]
+struct DarwinContext {
+    onstack: i32,
+    mask: libc::sigset_t,
+    stack: libc::stack_t,
+    link: *mut libc::c_void,
+    size: usize,
+    machine: *mut DarwinMachine,
+}
+#[cfg(all(target_vendor = "apple", target_arch = "aarch64"))]
+#[repr(C)]
+struct DarwinMachine {
+    exception: [u8; 16],
+    x: [u64; 29],
+    fp: u64,
+    lr: u64,
+    sp: u64,
+    pc: u64,
+    cpsr: u32,
+    padding: u32,
+}
+
+#[cfg(all(target_vendor = "apple", target_arch = "x86_64"))]
+#[repr(C)]
+struct DarwinMachine {
+    exception: [u8; 16],
+    registers: [u64; 16],
+    pc: u64,
+    flags: u64,
+    cs: u64,
+    fs: u64,
+    gs: u64,
+}
diff --git a/crates/trames-memory/src/mmu/host.rs b/crates/trames-memory/src/mmu/host.rs
new file mode 100644
index 0000000..66c741a
--- /dev/null
+++ b/crates/trames-memory/src/mmu/host.rs
@@ -0,0 +1,205 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Two aliases of anonymous RAM. Neither alias is executable host memory.
+use std::ptr::NonNull;
+
+pub(super) const WINDOW: usize = 16 * 1024 * 1024;
+
+pub(crate) struct Mapping {
+    pub cpu: NonNull<u8>,
+    pub kernel: NonNull<u8>,
+    pub registration: usize,
+}
+// SAFETY: ownership is immutable, mappings remain until the final owner drops.
+// Byte access requires the coordinator borrow or worker region guards. Merely
+// owning this handle grants no Rust reference or permission to access bytes.
+unsafe impl Send for Mapping {}
+unsafe impl Sync for Mapping {}
+
+pub(super) fn page_size() -> Option<usize> {
+    // SAFETY: sysconf has no pointer arguments and no memory side effects.
+    let size = unsafe { libc::sysconf(libc::_SC_PAGESIZE) };
+    let size = usize::try_from(size).ok()?;
+    (size.is_power_of_two() && (4096..=65536).contains(&size)).then_some(size)
+}
+
+impl Mapping {
+    /// Replace a range of our CPU alias with a shared view of an existing RAM
+    /// object. Source ownership stays in the frozen frames, never a raw lease.
+    pub fn alias(&self, offset: usize, source: &Mapping, source_offset: usize, len: usize) -> bool {
+        debug_assert!(offset <= WINDOW && len <= WINDOW - offset);
+        debug_assert!(source_offset <= WINDOW && len <= WINDOW - source_offset);
+        // SAFETY: fixed replacement is restricted to our reserved CPU range.
+        // Linux old_size=0 duplicates a MAP_SHARED view instead of moving it.
+        unsafe {
+            let target = self.cpu.as_ptr().add(offset).cast::<libc::c_void>();
+            let source = source
+                .kernel
+                .as_ptr()
+                .add(source_offset)
+                .cast::<libc::c_void>();
+            #[cfg(target_os = "linux")]
+            let ok = libc::mremap(
+                source,
+                0,
+                len,
+                libc::MREMAP_MAYMOVE | libc::MREMAP_FIXED,
+                target,
+            ) == target;
+            #[cfg(target_vendor = "apple")]
+            let ok = {
+                let mut address = target as u64;
+                let (mut current, mut maximum) = (0, 0);
+                mach_vm_remap(
+                    mach_task_self_,
+                    &mut address,
+                    len as u64,
+                    0,
+                    0x4000,
+                    mach_task_self_,
+                    source as u64,
+                    0,
+                    &mut current,
+                    &mut maximum,
+                    2,
+                ) == 0
+                    && address == target as u64
+            };
+            ok
+        }
+    }
+    pub fn new() -> Option<Self> {
+        if !super::fault::install() {
+            return None;
+        }
+        // SAFETY: all mappings use kernel-selected addresses, never MAP_FIXED
+        // over application allocations. Each success is cleaned up on failure.
+        unsafe {
+            #[cfg(target_os = "linux")]
+            let (cpu, kernel) = {
+                let fd = libc::memfd_create(c"trames-ram".as_ptr(), libc::MFD_CLOEXEC);
+                if fd < 0 {
+                    return None;
+                }
+                if libc::ftruncate(fd, WINDOW as libc::off_t) != 0 {
+                    libc::close(fd);
+                    return None;
+                }
+                let kernel = libc::mmap(
+                    std::ptr::null_mut(),
+                    WINDOW,
+                    libc::PROT_READ | libc::PROT_WRITE,
+                    libc::MAP_SHARED,
+                    fd,
+                    0,
+                );
+                let cpu = libc::mmap(
+                    std::ptr::null_mut(),
+                    WINDOW,
+                    libc::PROT_NONE,
+                    libc::MAP_SHARED,
+                    fd,
+                    0,
+                );
+                libc::close(fd);
+                (cpu, kernel)
+            };
+            #[cfg(target_vendor = "apple")]
+            let (cpu, kernel) = {
+                let kernel = libc::mmap(
+                    std::ptr::null_mut(),
+                    WINDOW,
+                    libc::PROT_READ | libc::PROT_WRITE,
+                    libc::MAP_PRIVATE | libc::MAP_ANON,
+                    -1,
+                    0,
+                );
+                let cpu = libc::mmap(
+                    std::ptr::null_mut(),
+                    WINDOW,
+                    libc::PROT_NONE,
+                    libc::MAP_PRIVATE | libc::MAP_ANON,
+                    -1,
+                    0,
+                );
+                if kernel != libc::MAP_FAILED && cpu != libc::MAP_FAILED {
+                    let mut address = cpu as u64;
+                    let (mut current, mut maximum) = (0, 0);
+                    let task = mach_task_self_;
+                    if mach_vm_remap(
+                        task,
+                        &mut address,
+                        WINDOW as u64,
+                        0,
+                        0x4000,
+                        task,
+                        kernel as u64,
+                        0,
+                        &mut current,
+                        &mut maximum,
+                        2,
+                    ) != 0
+                        || address != cpu as u64
+                        || libc::mprotect(cpu, WINDOW, libc::PROT_NONE) != 0
+                    {
+                        libc::munmap(cpu, WINDOW);
+                        libc::munmap(kernel, WINDOW);
+                        return None;
+                    }
+                }
+                (cpu, kernel)
+            };
+            if cpu == libc::MAP_FAILED || kernel == libc::MAP_FAILED {
+                if cpu != libc::MAP_FAILED {
+                    libc::munmap(cpu, WINDOW);
+                }
+                if kernel != libc::MAP_FAILED {
+                    libc::munmap(kernel, WINDOW);
+                }
+                return None;
+            }
+            let Some(registration) = super::fault::register(cpu as usize) else {
+                libc::munmap(cpu, WINDOW);
+                libc::munmap(kernel, WINDOW);
+                return None;
+            };
+            Some(Self {
+                cpu: NonNull::new_unchecked(cpu.cast()),
+                kernel: NonNull::new_unchecked(kernel.cast()),
+                registration,
+            })
+        }
+    }
+    pub fn protect(&self, offset: usize, len: usize, permissions: i32) -> bool {
+        debug_assert!(offset <= WINDOW && len <= WINDOW - offset);
+        // SAFETY: callers provide host-page-aligned ranges within our owned
+        // CPU alias. The kernel alias and unrelated host allocations are intact.
+        unsafe { libc::mprotect(self.cpu.as_ptr().add(offset).cast(), len, permissions) == 0 }
+    }
+}
+impl Drop for Mapping {
+    fn drop(&mut self) {
+        super::fault::unregister(self.registration);
+        // SAFETY: final ownership; no pointer, slice or worker survives this.
+        unsafe {
+            libc::munmap(self.cpu.as_ptr().cast(), WINDOW);
+            libc::munmap(self.kernel.as_ptr().cast(), WINDOW);
+        }
+    }
+}
+#[cfg(target_vendor = "apple")]
+unsafe extern "C" {
+    static mach_task_self_: libc::mach_port_t;
+    fn mach_vm_remap(
+        target: libc::mach_port_t,
+        address: *mut u64,
+        size: u64,
+        mask: u64,
+        flags: i32,
+        source: libc::mach_port_t,
+        source_address: u64,
+        copy: i32,
+        current: *mut i32,
+        maximum: *mut i32,
+        inheritance: i32,
+    ) -> i32;
+}
diff --git a/crates/trames-memory/src/mmu/mod.rs b/crates/trames-memory/src/mmu/mod.rs
new file mode 100644
index 0000000..55c5a16
--- /dev/null
+++ b/crates/trames-memory/src/mmu/mod.rs
@@ -0,0 +1,452 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Sparse, non-executable hardware-protected views of ordinary guest RAM.
+mod access;
+mod cache;
+pub(crate) use cache::Cache;
+pub use cache::DirectHint;
+mod fault;
+pub(crate) mod host;
+mod worker;
+use super::*;
+use host::WINDOW;
+use std::sync::atomic::{AtomicBool, AtomicU8, AtomicUsize};
+use std::{
+    ops::{Deref, DerefMut},
+    ptr::NonNull,
+    sync::Arc,
+};
+pub(crate) use worker::{Frozen, Pool, Slot};
+#[cfg(test)]
+mod tests;
+
+const ELIGIBLE: u8 = 4;
+const CODE: u8 = 8;
+const READ: u8 = 1;
+const WRITE: u8 = 2;
+const P: usize = PAGE_SIZE as usize;
+
+/// Kernel/native alias; never changes protection while a Rust slice exists.
+/// A clone copies bytes instead of aliasing writable pages: Rc::make_mut keeps
+/// the existing fork-COW contract even when the physical storage is mapped.
+pub(super) enum PageBytes {
+    Heap(Box<[u8; P]>),
+    Mapped {
+        owner: Arc<host::Mapping>,
+        offset: usize,
+        _lease: Option<Arc<Slot>>,
+    },
+}
+impl PageBytes {
+    pub fn new(bytes: [u8; P]) -> Self {
+        Self::Heap(Box::new(bytes))
+    }
+    pub(super) fn from_slot(slot: Arc<Slot>) -> Self {
+        Self::Mapped {
+            owner: slot.owner.clone(),
+            offset: slot.offset,
+            _lease: Some(slot),
+        }
+    }
+    pub(super) fn physical(&self) -> Option<(&Arc<host::Mapping>, usize)> {
+        if let Self::Mapped { owner, offset, .. } = self {
+            Some((owner, *offset))
+        } else {
+            None
+        }
+    }
+    fn belongs(&self, owner: &Arc<host::Mapping>, offset: usize) -> bool {
+        matches!(self, Self::Mapped { owner: old, offset: at, .. } if Arc::ptr_eq(owner, old) && *at == offset)
+    }
+}
+impl Clone for PageBytes {
+    fn clone(&self) -> Self {
+        Self::new(**self)
+    }
+}
+impl Deref for PageBytes {
+    type Target = [u8; P];
+    fn deref(&self) -> &Self::Target {
+        match self {
+            Self::Heap(bytes) => bytes,
+            // SAFETY: offset denotes one complete, initialized, 4KiB page of
+            // this live RW kernel mapping. Coordinator access is !Send/!Sync;
+            // no direct CPU write occurs while a shared byte borrow is live.
+            Self::Mapped { owner, offset, .. } => unsafe {
+                &*owner.kernel.as_ptr().add(*offset).cast()
+            },
+        }
+    }
+}
+impl DerefMut for PageBytes {
+    fn deref_mut(&mut self) -> &mut Self::Target {
+        match self {
+            Self::Heap(bytes) => bytes,
+            // SAFETY: Rc::make_mut detached any fork peers. Different page
+            // objects cover disjoint subranges; this exclusive borrow excludes
+            // CPU access, native callbacks and mapping mutation on the owner.
+            Self::Mapped { owner, offset, .. } => unsafe {
+                &mut *owner.kernel.as_ptr().add(*offset).cast()
+            },
+        }
+    }
+}
+
+pub(crate) struct Window {
+    base: u64,
+    mapping: Arc<host::Mapping>,
+    flags: Box<[AtomicU8]>,
+    frames: Box<[AtomicUsize]>,
+    initialized: Box<[AtomicBool]>,
+    granule: usize,
+}
+impl Window {
+    fn new(base: u64, granule: usize) -> Option<Self> {
+        Some(Self {
+            base,
+            mapping: Arc::new(host::Mapping::new()?),
+            granule,
+            flags: (0..WINDOW / granule).map(|_| AtomicU8::new(0)).collect(),
+            frames: (0..WINDOW / P)
+                .map(|_| AtomicUsize::new(usize::MAX))
+                .collect(),
+            initialized: (0..WINDOW / P).map(|_| AtomicBool::new(false)).collect(),
+        })
+    }
+    fn page(&self, offset: usize, zero: bool) -> Rc<PageBytes> {
+        if zero && self.initialized[offset / P].swap(true, Ordering::Relaxed) {
+            // SAFETY: a newly installed private anonymous page has no existing
+            // byte borrows. Fork retires the complete CPU arena before sharing.
+            unsafe {
+                std::ptr::write_bytes(self.mapping.kernel.as_ptr().add(offset), 0, P);
+            }
+        } else {
+            self.initialized[offset / P].store(true, Ordering::Relaxed);
+        }
+        Rc::new(PageBytes::Mapped {
+            owner: self.mapping.clone(),
+            offset,
+            _lease: None,
+        })
+    }
+    fn protect_run(&self, begin: usize, end: usize, state: u8) {
+        let protection = (if state & READ != 0 {
+            libc::PROT_READ
+        } else {
+            0
+        }) | if state & WRITE != 0 {
+            libc::PROT_WRITE
+        } else {
+            0
+        };
+        let ok = self.mapping.protect(
+            begin * self.granule,
+            (end - begin) * self.granule,
+            protection,
+        );
+        for index in begin..end {
+            self.flags[index].store(if ok { state } else { 0 }, Ordering::Relaxed);
+        }
+    }
+}
+
+pub(super) struct Arena {
+    windows: RefCell<BTreeMap<u64, Rc<Window>>>,
+    cache: Cache,
+    key: Cell<u64>,
+    granule: usize,
+}
+impl Default for Arena {
+    fn default() -> Self {
+        Self {
+            windows: RefCell::new(BTreeMap::new()),
+            cache: Cache::default(),
+            key: Cell::new(NEXT_SPACE.fetch_add(1, Ordering::Relaxed)),
+            granule: host::page_size().unwrap_or(0),
+        }
+    }
+}
+impl Arena {
+    fn window(&self, address: u64, create: bool) -> Option<Rc<Window>> {
+        if self.granule == 0 {
+            return None;
+        }
+        let base = address & !(WINDOW as u64 - 1);
+        if let Some(window) = self.windows.borrow().get(&base) {
+            return Some(window.clone());
+        }
+        if !create {
+            return None;
+        }
+        let window = Rc::new(Window::new(base, self.granule)?);
+        self.windows.borrow_mut().insert(base, window.clone());
+        Some(window)
+    }
+    #[inline]
+    fn reached(&self, address: u64) -> Option<&Window> {
+        let base = address & !(WINDOW as u64 - 1);
+        if let Some(pointer) = self.cache.get(base) {
+            // SAFETY: retire clears all entries before dropping pinned windows.
+            return Some(unsafe { pointer.as_ref() });
+        }
+        self.reached_slow(base)
+    }
+    #[cold]
+    fn reached_slow(&self, base: u64) -> Option<&Window> {
+        let windows = self.windows.borrow();
+        let pointer = NonNull::from(windows.get(&base)?.as_ref());
+        self.cache.insert(base, pointer);
+        // SAFETY: the map retains this allocation after the temporary RefCell
+        // borrow ends. No callback or map mutation occurs during this access.
+        Some(unsafe { pointer.as_ref() })
+    }
+    pub fn page(&self, base: u64) -> Option<Rc<PageBytes>> {
+        let window = self.window(base, true)?;
+        Some(window.page((base - window.base) as usize, true))
+    }
+    /// Fork stops using the old CPU aliases before sharing any Rc byte owner.
+    /// Retired kernel aliases stay alive through their PageBytes. New mapping
+    /// windows are populated lazily; fork does not eagerly copy guest RAM.
+    pub fn retire(&self) {
+        self.key.set(NEXT_SPACE.fetch_add(1, Ordering::Relaxed));
+        self.cache.clear();
+        for window in self.windows.borrow().values() {
+            for flag in &window.flags {
+                flag.store(0, Ordering::Relaxed);
+            }
+            window.mapping.protect(0, WINDOW, libc::PROT_NONE);
+        }
+        self.windows.borrow_mut().clear();
+    }
+    #[inline]
+    pub fn hint(&self) -> DirectHint {
+        self.cache.hint(self.key.get())
+    }
+    #[inline(always)]
+    pub fn read_hint<const N: usize>(
+        &self,
+        address: u64,
+        hint: &mut DirectHint,
+    ) -> Option<[u8; N]> {
+        if let Some((window, bias)) = hint.reached(self.key.get(), address) {
+            return Self::read_at(window, bias, address);
+        }
+        let result = self.read(address);
+        *hint = self.hint();
+        result
+    }
+    #[inline(always)]
+    pub fn write_hint<const N: usize>(
+        &self,
+        address: u64,
+        bytes: [u8; N],
+        hint: &mut DirectHint,
+    ) -> Option<usize> {
+        if let Some((window, bias)) = hint.reached(self.key.get(), address) {
+            return Self::write_at(window, bias, address, bytes);
+        }
+        let result = self.write(address, bytes);
+        *hint = self.hint();
+        result
+    }
+    #[inline]
+    fn ready(&self, address: u64) -> bool {
+        self.reached(address).is_some_and(|window| {
+            window.flags[(address - window.base) as usize / window.granule].load(Ordering::Relaxed)
+                & ELIGIBLE
+                != 0
+        })
+    }
+    #[inline]
+    pub fn read<const N: usize>(&self, address: u64) -> Option<[u8; N]> {
+        if !matches!(N, 1 | 2 | 4 | 8 | 16) || N > P - (address as usize & (P - 1)) {
+            return None;
+        }
+        let window = self.reached(address)?;
+        Self::read_at(
+            window,
+            (window.mapping.cpu.as_ptr() as usize).wrapping_sub(window.base as usize),
+            address,
+        )
+    }
+    #[inline(always)]
+    fn read_at<const N: usize>(window: &Window, bias: usize, address: u64) -> Option<[u8; N]> {
+        if !matches!(N, 1 | 2 | 4 | 8 | 16) || N > P - (address as usize & (P - 1)) {
+            return None;
+        }
+        let offset = (address - window.base) as usize;
+        if window.flags[offset / window.granule].load(Ordering::Relaxed) & ELIGIBLE == 0 {
+            return None;
+        }
+        let mut bytes = [0; N];
+        // SAFETY: the target remains inside our registered CPU alias and one
+        // host page; the asm fixup returns false without touching the output.
+        if unsafe {
+            access::access::<N>(
+                false,
+                bias.wrapping_add(address as usize) as *mut u8,
+                bytes.as_mut_ptr(),
+            )
+        } {
+            Some(bytes)
+        } else {
+            None
+        }
+    }
+    #[inline]
+    pub fn write<const N: usize>(&self, address: u64, bytes: [u8; N]) -> Option<usize> {
+        if !matches!(N, 1 | 2 | 4 | 8 | 16) || N > P - (address as usize & (P - 1)) {
+            return None;
+        }
+        let window = self.reached(address)?;
+        Self::write_at(
+            window,
+            (window.mapping.cpu.as_ptr() as usize).wrapping_sub(window.base as usize),
+            address,
+            bytes,
+        )
+    }
+    #[inline(always)]
+    fn write_at<const N: usize>(
+        window: &Window,
+        bias: usize,
+        address: u64,
+        mut bytes: [u8; N],
+    ) -> Option<usize> {
+        if !matches!(N, 1 | 2 | 4 | 8 | 16) || N > P - (address as usize & (P - 1)) {
+            return None;
+        }
+        let offset = (address - window.base) as usize;
+        let state = window.flags[offset / window.granule].load(Ordering::Relaxed);
+        if state & (ELIGIBLE | CODE) != ELIGIBLE {
+            return None;
+        }
+        // SAFETY: same bounded target invariant as read. A rejected store is
+        // wholly inside one hardware page, so it has no partial guest effects.
+        if unsafe {
+            access::access::<N>(
+                true,
+                bias.wrapping_add(address as usize) as *mut u8,
+                bytes.as_mut_ptr(),
+            )
+        } {
+            Some(window.frames[offset / P].load(Ordering::Relaxed))
+        } else {
+            None
+        }
+    }
+}
+
+impl Memory {
+    pub(super) fn prepare_mmu_write(&mut self, address: u64, len: usize) {
+        if len <= P - (address as usize & (P - 1)) && self.mmu.ready(address) {
+            return;
+        }
+        self.refresh_mmu(address, len as u64);
+    }
+    /// Called only at quiescent mapping/COW boundaries. Hardware groups with
+    /// holes, mixed permissions or backing I/O stay on the shared software path.
+    pub(super) fn refresh_mmu(&mut self, address: u64, len: u64) {
+        let granule = self.mmu.granule;
+        if granule == 0 || len == 0 {
+            return;
+        }
+        let begin = address & !(granule as u64 - 1);
+        let end = address
+            .saturating_add(len)
+            .saturating_add(granule as u64 - 1)
+            & !(granule as u64 - 1);
+        let mut at = begin;
+        while at < end {
+            let stop = end.min((at & !(WINDOW as u64 - 1)) + WINDOW as u64);
+            let Some(window) = self
+                .mmu
+                .window(at, self.pages.range(at..stop).next().is_some())
+            else {
+                // Huge reserved/hole ranges own no physical windows. Skip the
+                // entire sparse window instead of inspecting every 4KiB page.
+                at = stop;
+                continue;
+            };
+            let mut run: Option<(usize, usize, u8)> = None;
+            while at < stop {
+                let first = (at - window.base) as usize;
+                let group = first / granule;
+                let mut frames = Vec::new();
+                let mut permissions = None;
+                for base in (at..at + granule as u64).step_by(P) {
+                    let Some(&frame) = self.pages.get(&base) else {
+                        break;
+                    };
+                    let page = self.frames[frame].as_ref().expect("mapped page");
+                    if page.backing.is_some() || permissions.is_some_and(|p| p != page.permissions)
+                    {
+                        break;
+                    }
+                    permissions = Some(page.permissions);
+                    frames.push(frame);
+                }
+                let mut state = 0;
+                if frames.len() == granule / P
+                    && permissions.is_some_and(|p: Permissions| p.read || !p.write)
+                {
+                    let permissions = permissions.expect("complete group");
+                    if frames.iter().enumerate().any(|(index, &frame)| {
+                        let page = self.frames[frame].as_ref().expect("mapped page");
+                        Rc::strong_count(&page.bytes) != 1
+                            || !page.bytes.belongs(&window.mapping, first + index * P)
+                    }) {
+                        // Capture the complete group before writing: remap may
+                        // move overlapping ranges within an existing window.
+                        let data: Vec<_> = frames
+                            .iter()
+                            .map(|&frame| **self.frames[frame].as_ref().unwrap().bytes)
+                            .collect();
+                        for (index, (&frame, bytes)) in frames.iter().zip(&data).enumerate() {
+                            let offset = first + index * P;
+                            // SAFETY: private destination, all old sources were
+                            // captured; no Rust references alias this write.
+                            unsafe {
+                                std::ptr::copy_nonoverlapping(
+                                    bytes.as_ptr(),
+                                    window.mapping.kernel.as_ptr().add(offset),
+                                    P,
+                                );
+                            }
+                            self.frames[frame].as_mut().unwrap().bytes = window.page(offset, false);
+                        }
+                    }
+                    for (index, &frame) in frames.iter().enumerate() {
+                        window.frames[first / P + index].store(frame, Ordering::Relaxed);
+                    }
+                    state = ELIGIBLE
+                        | if permissions.read { READ } else { 0 }
+                        | if permissions.write && !permissions.execute {
+                            WRITE
+                        } else {
+                            0
+                        }
+                        | if permissions.execute { CODE } else { 0 };
+                }
+                if state != window.flags[group].load(Ordering::Relaxed) {
+                    match run {
+                        Some((start, last, previous)) if last == group && previous == state => {
+                            run = Some((start, group + 1, state))
+                        }
+                        previous => {
+                            if let Some((start, last, state)) = previous {
+                                window.protect_run(start, last, state);
+                            }
+                            run = Some((group, group + 1, state));
+                        }
+                    }
+                } else if let Some((start, last, state)) = run.take() {
+                    window.protect_run(start, last, state);
+                }
+                at += granule as u64;
+            }
+            if let Some((start, last, state)) = run {
+                window.protect_run(start, last, state);
+            }
+        }
+    }
+}
