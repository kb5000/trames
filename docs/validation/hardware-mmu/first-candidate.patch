+        write: bool,
+        hint: &mut DirectHint,
+    ) -> Option<Operand<'a>> {
+        if !matches!(len, 1 | 2 | 4 | 8 | 16) || len > P - (address as usize & (P - 1)) {
+            return None;
+        }
+        let (window, bias) = if let Some(reached) = hint.reached(self.key, address) {
+            reached
