+        for seed in [0, 1, u64::MAX, 0x8000000080000000] {
+            for start in 0..words.len() {
+                for budget in 0..=words.len() as u64 + 1 {
+                    for r in 0..31 {
+                        cpu.set_x(r, seed.wrapping_add(r as u64));
+                    }
+                    cpu.pc = 0x1000 + start as u64 * 4;
+                    cpu.sp = seed;
+                    cpu.set_flags(Flags {
+                        n: true,
+                        z: false,
+                        c: true,
+                        v: false,
