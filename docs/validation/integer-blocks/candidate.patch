+        let arithmetic = [
+            0xd29fdb80, 0xf2d75300, 0x91002c00, 0xca401401, 0x910043ff, 0xd10023ff, 0xb10017ff,
+            0xb2401c1f, 0x91001fe2, 0xcb811c42, 0xeac02c43, 0xb2781c63, 0xb3476463, 0x13032464,
