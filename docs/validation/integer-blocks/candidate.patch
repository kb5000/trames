+            0x9b2118c6, 0x9ba118c6, 0x9b407cc6, 0x9bc07cc6, 0x9ac120c6, 0x1ac228c6, 0x9ac32cc6,
+            0x9ac00cc6, 0x1ac008c6, 0x10000007, 0x90000008,
+        ];
+        let mut words = Vec::new();
+        for group in arithmetic.chunks(4) {
+            words.extend_from_slice(group);
+            words.push(0xd503201f); // stop a block, keep executing the program
+        }
+        words.push(0xd4000001);
+        let mut mem = memory(&words);
+        let mut cpu = Cpu::new(0x1000, 0x2ff0);
+        // Reverse-order warming also exercises a terminator decoded first.
+        for slot in (0..words.len()).rev() {
