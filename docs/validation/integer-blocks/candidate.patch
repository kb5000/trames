+    fn integer_blocks_obey_page_capacity_permissions_and_generation_wrap() {
+        let mut words = Vec::new();
+        for _ in 0..256 {
+            words.extend_from_slice(&[0x91000400, 0x91000800, 0xd503201f, 0xd503201f]);
+        }
+        let mut mem = memory(&words);
+        let mut cpu = Cpu::new(0x1000, 0);
+        for _ in 0..blocks::HOT_VISITS {
+            cpu.pc = 0x1000;
+            cpu.run_slice(&mut mem, 1024);
+        }
+        let page = cpu
+            .decoded
+            .slots
+            .iter_mut()
+            .flatten()
+            .find(|p| p.base == 0x1000)
+            .unwrap();
+        assert_eq!(page.blocks.len(), 256);
+        assert!(page.pending_blocks.is_empty());
+        page.generation = u64::MAX;
+        mem.write(0x1004, &0x91002000u32.to_le_bytes()).unwrap();
+        cpu.pc = 0x1000;
+        cpu.set_x(0, 0);
+        cpu.run_slice(&mut mem, 2);
+        assert_eq!(cpu.x(0), 9);
+        let page = cpu
+            .decoded
+            .slots
