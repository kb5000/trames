+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Shared scalar semantics for single instructions and bounded integer blocks.
+use super::*;
+
+// Roles are rn, rm, old rd, multiply accumulator. Forwarding is computed when
+// the block is formed, not by comparing guest register numbers on every read.
+struct Operands<'a, const FORWARD: bool> {
+    cpu: &'a mut Cpu,
+    value: u64,
+    forwards: u8,
+    commit: bool,
+}
+impl<const FORWARD: bool> Operands<'_, FORWARD> {
+    #[inline(always)]
+    fn read<const ROLE: u8>(&self, index: usize, sp: bool) -> u64 {
+        if FORWARD && self.forwards & (1 << ROLE) != 0 {
+            self.value
+        } else {
+            self.cpu.reg(index, sp)
+        }
+    }
+    #[inline(always)]
+    fn put(&mut self, index: usize, value: u64, wide: bool, sp: bool) {
+        self.value = value & width_mask(wide);
+        if self.commit {
+            self.cpu.put(index, value, wide, sp);
+        }
+    }
+}
+
+#[inline(always)]
+fn integer<const TAG: usize, const FORWARD: bool>(
+    ins: &Instruction,
+    bank: &mut Operands<'_, FORWARD>,
+    flags: &mut ConditionFlags,
+    pc: u64,
+) {
+    let (rd, rn, rm) = (ins.rd.index(), ins.rn.index(), ins.rm.index());
+    let wide = ins.wide;
+    let mask = width_mask(wide);
+    match ins.op {
+        Op::Move { opc, shift, value } if TAG == 2 => {
+            let value = match opc {
+                0 => !value,
+                2 => value,
+                _ => (bank.read::<2>(rd, false) & !(0xffffu64 << shift)) | value,
+            };
+            bank.put(rd, value, wide, false);
+        }
+        Op::Address { immediate } if TAG == 3 => bank.put(
+            rd,
+            if wide {
+                (pc & !4095).wrapping_add(immediate << 12)
+            } else {
+                pc.wrapping_add(immediate)
+            },
+            true,
+            false,
+        ),
+        Op::AddImmediate { value } if TAG == 4 => {
+            bank.put(rd, bank.read::<0>(rn, true).wrapping_add(value), wide, true);
+        }
+        Op::FlagsImmediate { sub, value } if TAG == 5 => {
+            let value = flags.calculate(bank.read::<0>(rn, true), value, sub, true, wide);
+            bank.put(rd, value, wide, false);
+        }
+        Op::AddShift {
+            sub,
+            flags: set_flags,
+            kind,
+            amount,
+        } if TAG == 6 => {
+            let value = flags.calculate(
+                bank.read::<0>(rn, false),
+                shifted(bank.read::<1>(rm, false), kind as u32, amount as u32, wide),
+                sub,
+                set_flags,
+                wide,
+            );
+            bank.put(rd, value, wide, false);
+        }
+        Op::LogicalShift {
+            opc,
+            invert,
+            kind,
+            amount,
+        } if TAG == 8 => {
+            let rhs = shifted(bank.read::<1>(rm, false), kind as u32, amount as u32, wide);
+            logical(
+                ins,
+                bank,
+                if invert { !rhs } else { rhs },
+                opc,
+                false,
+                flags,
+            );
+        }
+        Op::LogicalImmediate { opc, value } if TAG == 9 => {
+            logical(ins, bank, value, opc, opc != 3, flags)
+        }
+        Op::Bitfield {
+            opc,
+            r,
+            s,
+            wmask,
+            tmask,
+        } if TAG == 10 => {
+            let value = rotate(
+                bank.read::<0>(rn, false) & mask,
+                r as u32,
+                if wide { 64 } else { 32 },
+            );
+            let value = match opc {
+                0 => {
+                    let top = if bank.read::<0>(rn, false) & (1 << s) != 0 {
+                        mask
+                    } else {
+                        0
+                    };
+                    (top & !tmask) | (value & wmask & tmask)
+                }
+                1 => {
+                    (bank.read::<2>(rd, false) & !tmask)
+                        | (((bank.read::<2>(rd, false) & !wmask) | (value & wmask)) & tmask)
+                }
+                _ => value & wmask & tmask,
+            };
+            bank.put(rd, value, wide, false);
+        }
+        Op::Select {
+            condition,
+            invert,
+            increment,
+        } if TAG == 11 => {
+            let value = if flags.condition(condition as u32) {
+                bank.read::<0>(rn, false)
+            } else {
+                let value = if invert {
+                    !bank.read::<1>(rm, false)
+                } else {
+                    bank.read::<1>(rm, false)
+                };
+                if increment {
+                    value.wrapping_add(1)
+                } else {
+                    value
+                }
+            };
+            bank.put(rd, value, wide, false);
+        }
+        Op::AddExtended {
+            sub,
+            flags: set_flags,
+            signed,
+            bits,
+            amount,
+        } if TAG == 12 => {
+            let rhs = bank.read::<1>(rm, false) & ones(bits as u32);
+            let rhs = if signed {
+                sign_extend(rhs, bits as u32)
+            } else {
+                rhs
+            };
+            let value = flags.calculate(
+                bank.read::<0>(rn, true),
+                rhs.wrapping_shl(amount as u32),
+                sub,
+                set_flags,
+                wide,
+            );
+            bank.put(rd, value, wide, !set_flags);
+        }
+        Op::Compare {
+            condition,
+            immediate,
+            sub,
+            nzcv,
+        } if TAG == 13 => {
+            if flags.condition(condition as u32) {
+                flags.calculate(
+                    bank.read::<0>(rn, false),
+                    if immediate {
+                        rm as u64
+                    } else {
+                        bank.read::<1>(rm, false)
+                    },
+                    sub,
+                    true,
+                    wide,
+                );
+            } else {
+                flags.set(nzcv as u32);
+            }
+        }
+        Op::Multiply { kind, ra, sub } if TAG == 14 => {
+            let product = match kind {
+                0 => bank
+                    .read::<0>(rn, false)
+                    .wrapping_mul(bank.read::<1>(rm, false)),
+                1 => (bank.read::<0>(rn, false) as u32 as i32 as i64)
+                    .wrapping_mul(bank.read::<1>(rm, false) as u32 as i32 as i64)
+                    as u64,
+                5 => {
+                    (bank.read::<0>(rn, false) as u32 as u64)
+                        * (bank.read::<1>(rm, false) as u32 as u64)
+                }
+                2 => {
+                    ((bank.read::<0>(rn, false) as i64 as i128
+                        * bank.read::<1>(rm, false) as i64 as i128)
+                        >> 64) as u64
+                }
+                _ => {
+                    ((bank.read::<0>(rn, false) as u128 * bank.read::<1>(rm, false) as u128) >> 64)
+                        as u64
+                }
+            };
+            let value = if matches!(kind, 2 | 6) {
+                product
+            } else if sub {
+                bank.read::<3>(ra.index(), false).wrapping_sub(product)
+            } else {
+                bank.read::<3>(ra.index(), false).wrapping_add(product)
+            };
+            bank.put(rd, value, wide, false);
+        }
+        Op::ShiftVariable { kind } if TAG == 15 => {
+            let amount = (bank.read::<1>(rm, false) & if wide { 63 } else { 31 }) as u32;
+            bank.put(
+                rd,
+                shifted(bank.read::<0>(rn, false), kind as u32, amount, wide),
+                wide,
+                false,
+            );
+        }
+        Op::Divide { signed } if TAG == 16 => {
+            let a = bank.read::<0>(rn, false) & mask;
+            let b = bank.read::<1>(rm, false) & mask;
+            let value = if b == 0 {
+                0
+            } else if !signed {
+                a / b
+            } else if wide {
+                (a as i64).wrapping_div(b as i64) as u64
+            } else {
+                (a as u32 as i32).wrapping_div(b as u32 as i32) as u32 as u64
+            };
+            bank.put(rd, value, wide, false);
+        }
+        // SAFETY: both dispatchers select TAG from this exact immutable Op.
+        // No cache mutation occurs between dispatch and this specialization.
+        _ => unsafe { std::hint::unreachable_unchecked() },
+    }
+}
+
+#[inline]
+fn logical<const FORWARD: bool>(
+    ins: &Instruction,
+    bank: &mut Operands<'_, FORWARD>,
+    rhs: u64,
+    opc: u8,
+    sp: bool,
+    flags: &mut ConditionFlags,
+) {
+    let (rd, rn, wide) = (ins.rd.index(), ins.rn.index(), ins.wide);
+    let value = match opc {
+        0 | 3 => bank.read::<0>(rn, false) & rhs,
+        1 => bank.read::<0>(rn, false) | rhs,
+        _ => bank.read::<0>(rn, false) ^ rhs,
+    } & width_mask(wide);
+    if opc == 3 {
+        flags.set(
+            ((value & (if wide { 1 << 63 } else { 1 << 31 }) != 0) as u32) << 3
+                | ((value == 0) as u32) << 2,
+        );
+    }
+    bank.put(rd, value, wide, sp);
+}
+
+#[inline(always)]
+pub(super) fn single<const TAG: usize>(
+    cpu: &mut Cpu,
+    ins: &Instruction,
+    flags: &mut ConditionFlags,
+    pc: u64,
+) {
+    integer::<TAG, false>(
+        ins,
+        &mut Operands {
+            cpu,
+            value: 0,
+            forwards: 0,
+            commit: true,
+        },
+        flags,
+        pc,
+    );
+}
+
+const MAX_STEPS: usize = 16;
+const MIN_STEPS: usize = 2;
+const MAX_BLOCKS: usize = 256;
+pub(super) const HOT_VISITS: u8 = 64;
+
+#[derive(Debug)]
+pub(super) struct Step {
+    pub(super) instruction: Instruction,
+    forwards: u8,
+    commit: bool,
+}
+#[derive(Debug)]
+pub(super) struct Block {
+    pub(super) tag: u8,
+    pub(super) steps: [Step; 2],
+    branch: Option<(u64, u8)>,
+}
+fn integer_op(ins: Instruction) -> bool {
+    matches!(
+        ins.op,
+        Op::Move { .. }
+            | Op::Address { .. }
+            | Op::AddImmediate { .. }
+            | Op::FlagsImmediate { .. }
+            | Op::AddShift { .. }
+            | Op::FlagsBranch { .. }
+            | Op::LogicalShift { .. }
+            | Op::LogicalImmediate { .. }
+            | Op::Bitfield { .. }
+            | Op::Select { .. }
+            | Op::AddExtended { .. }
+            | Op::Compare { .. }
+            | Op::Multiply { .. }
+            | Op::ShiftVariable { .. }
+            | Op::Divide { .. }
+    )
+}
+// Distinguish SP from XZR before computing data dependencies. XZR never
+// forwards, even when two instructions both encode register number 31.
+fn identity(register: Register, sp: bool) -> u8 {
+    if register.0 == 31 && sp {
+        32
+    } else {
+        register.0
+    }
+}
+fn output(ins: Instruction) -> u8 {
+    if matches!(ins.op, Op::Compare { .. }) {
+        return 31;
+    }
+    identity(
+        ins.rd,
+        matches!(
+            ins.op,
+            Op::AddImmediate { .. }
+                | Op::AddExtended { flags: false, .. }
+                | Op::LogicalImmediate { opc: 0..=2, .. }
+        ),
+    )
+}
+impl CodePage {
+    #[inline(always)]
+    pub(super) fn block(&self, index: usize) -> &Block {
+        debug_assert!(index < self.blocks.len());
+        // SAFETY: the cached Block op is installed with its Vec index. All block
+        // tail transitions preserve it. No decoder, cache mutation or guest
+        // memory operation can run until this bounded integer block finishes.
+        unsafe { self.blocks.get_unchecked(index) }
+    }
+    pub(super) fn visit(&mut self) {
+        if self.visits < HOT_VISITS {
+            self.visits += 1;
+            if self.visits == HOT_VISITS {
+                let mut pending = std::mem::take(&mut self.pending_blocks);
+                for &slot in &pending {
+                    self.form_block(slot as usize);
+                }
+                pending.clear();
+                self.pending_blocks = pending;
+            }
+        }
+    }
+    pub(super) fn form_block(&mut self, slot: usize) {
+        if self.visits < HOT_VISITS {
+            if !integer_op(self.instructions[slot].instruction) || slot + 1 == PAGE_WORDS {
+                self.pending_blocks.push(slot as u16);
+            }
+            return;
+        }
+        if self.blocks.len() == MAX_BLOCKS {
+            return;
+        }
+        let valid = |slot: usize| {
+            slot < PAGE_WORDS && self.instructions[slot].generation == self.generation
+        };
+        let mut end = slot;
+        if integer_op(self.instructions[slot].instruction) {
+            while valid(end)
+                && integer_op(self.instructions[end].instruction)
+                && end - slot < MAX_STEPS
+            {
+                end += 1;
+            }
+            if end < PAGE_WORDS && !valid(end) {
+                return;
+            }
+        }
+        let mut start = end;
+        while start > 0
+            && end - start < MAX_STEPS
+            && valid(start - 1)
+            && integer_op(self.instructions[start - 1].instruction)
+        {
+            start -= 1;
+        }
+        if end - start < MIN_STEPS {
+            return;
+        }
+        let instructions: Vec<_> = (start..end)
+            .map(|slot| {
+                let mut ins = self.instructions[slot].instruction;
+                if matches!(ins.op, Op::FlagsBranch { .. }) {
+                    // The following branch has its own original entry. Count it once.
+                    ins = Instruction::decode(ins.word);
+                }
+                if let Op::Address { immediate } = ins.op {
+                    let pc = self.base + slot as u64 * 4;
+                    let value = if ins.wide {
+                        (pc & !4095).wrapping_add(immediate << 12)
+                    } else {
+                        pc.wrapping_add(immediate)
+                    };
+                    ins.op = Op::Move {
+                        opc: 2,
+                        shift: 0,
+                        value,
+                    };
+                    ins.wide = true;
+                }
+                ins
+            })
+            .collect();
+        let branch = if valid(end) {
+            if let Op::ConditionalBranch { offset, condition } =
+                self.instructions[end].instruction.op
+            {
+                Some((offset, condition))
+            } else {
+                None
+            }
+        } else {
+            None
+        };
+        let skip = instructions.len() % 2;
+        for (part, pair) in instructions[skip..].chunks_exact(2).enumerate() {
+            if self.blocks.len() == MAX_BLOCKS {
+                break;
+            }
+            let mut previous = 31;
+            let steps = std::array::from_fn(|i| {
+                let ins = pair[i];
+                let source_sp = matches!(
+                    ins.op,
+                    Op::AddImmediate { .. } | Op::FlagsImmediate { .. } | Op::AddExtended { .. }
+                );
+                let sources = [
+                    identity(ins.rn, source_sp),
+                    ins.rm.0,
+                    ins.rd.0,
+                    if let Op::Multiply { ra, .. } = ins.op {
+                        ra.0
+                    } else {
+                        31
+                    },
+                ];
+                let forwards = sources.iter().enumerate().fold(0, |bits, (role, &source)| {
+                    bits | (u8::from(previous != 31 && source == previous) << role)
+                });
+                let destination = output(ins);
+                let commit = destination == 31
+                    || pair
+                        .get(i + 1)
+                        .is_none_or(|next| output(*next) != destination);
+                previous = destination;
+                Step {
+                    instruction: ins,
+                    forwards,
+                    commit,
+                }
+            });
+            let index = self.blocks.len() as u16;
+            let tag = integer_tag(pair[0]) * 13 + integer_tag(pair[1]);
+            self.blocks.push(Block {
+                steps,
+                tag,
+                branch: if skip + part * 2 + 2 == instructions.len() {
+                    branch
+                } else {
+                    None
+                },
+            });
+            self.instructions[start + skip + part * 2].instruction.op = Op::Block { index };
+        }
+    }
+}
+fn integer_tag(ins: Instruction) -> u8 {
+    match ins.op {
+        Op::Move { .. } => 0,
+        Op::AddImmediate { .. } => 1,
+        Op::FlagsImmediate { .. } => 2,
+        Op::AddShift { .. } => 3,
+        Op::LogicalShift { .. } => 4,
+        Op::LogicalImmediate { .. } => 5,
+        Op::Bitfield { .. } => 6,
+        Op::Select { .. } => 7,
+        Op::AddExtended { .. } => 8,
+        Op::Compare { .. } => 9,
+        Op::Multiply { .. } => 10,
+        Op::ShiftVariable { .. } => 11,
+        Op::Divide { .. } => 12,
+        _ => unreachable!("not a prepared integer operation"),
+    }
+}
+impl Block {
+    #[inline(always)]
+    pub(super) fn pair<const A: usize, const B: usize>(
+        &self,
+        cpu: &mut Cpu,
+        flags: &mut ConditionFlags,
+        remaining: u64,
+    ) -> u64 {
+        let value = self.step::<A, false>(0, 2, cpu, flags, 0);
+        self.step::<B, true>(1, 2, cpu, flags, value);
+        self.finish(cpu, flags, 2, remaining)
+    }
+    #[inline(always)]
+    pub(super) fn step<const TAG: usize, const FORWARD: bool>(
+        &self,
+        index: usize,
+        length: usize,
+        cpu: &mut Cpu,
+        flags: &mut ConditionFlags,
+        value: u64,
+    ) -> u64 {
+        debug_assert!(index < length && length <= self.steps.len());
+        // SAFETY: pair construction always stores exactly two steps. The caller
+        // uses index zero, or index one only with length two. Its compile-time
+        // operation tags are selected by the immutable pair's validated tag.
+        let step = unsafe { self.steps.get_unchecked(index) };
+        let mut bank = Operands::<FORWARD> {
+            cpu,
+            value,
+            forwards: step.forwards,
+            commit: step.commit || index + 1 == length,
+        };
+        integer::<TAG, FORWARD>(&step.instruction, &mut bank, flags, 0);
+        bank.value
+    }
+    #[inline(always)]
+    pub(super) fn finish(
+        &self,
+        cpu: &mut Cpu,
+        flags: &mut ConditionFlags,
+        length: usize,
+        remaining: u64,
+    ) -> u64 {
+        let mut count = length as u64;
+        cpu.pc = cpu.pc.wrapping_add(count * 4);
+        if let Some((offset, condition)) = self.branch.filter(|_| remaining > count) {
+            cpu.pc = cpu.pc.wrapping_add(if flags.condition(condition as u32) {
+                offset
+            } else {
+                4
+            });
+            count += 1;
+        }
+        count
+    }
+}
