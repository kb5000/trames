+#[inline(never)]
+extern "rust-preserve-none" fn tail_pair<M: CpuMemory, const A: usize, const B: usize>(
+    state: &mut TailState<'_, M>,
+    block: usize,
+    executed: u64,
+) -> TailExit {
+    debug_assert!(executed < state.budget);
+    // SAFETY: ordinary dispatch checks the budget before entering a pair.
+    unsafe { std::hint::assert_unchecked(executed < state.budget) };
+    if state.budget - executed == 1 {
+        become tail_pair_partial::<M, A>(state, block, executed);
+    }
+    let count =
+        state
+            .page
+            .block(block)
+            .pair::<A, B>(state.cpu, state.flags, state.budget - executed);
+    #[cfg(test)]
+    {
+        state.stats.block_runs += 1;
+        state.stats.block_instructions += count;
+    }
+    debug_assert!(count <= state.budget - executed);
+    let executed = executed.wrapping_add(count);
+    tail_next!(state, executed)
+}
+
+#[inline(never)]
+extern "rust-preserve-none" fn tail_pair_partial<M: CpuMemory, const A: usize>(
+    state: &mut TailState<'_, M>,
+    block: usize,
+    executed: u64,
+) -> TailExit {
+    let pc = state.cpu.pc;
+    blocks::single::<A>(
+        state.cpu,
+        &state.page.block(block).steps[0].instruction,
+        state.flags,
+        pc,
+    );
+    state.cpu.pc = pc.wrapping_add(4);
+    #[cfg(test)]
+    {
+        state.stats.block_runs += 1;
+        state.stats.block_instructions += 1;
+    }
+    debug_assert_eq!(state.budget - executed, 1);
+    TailExit::Stop(SliceOutcome::Yield {
+        instructions: executed + 1,
+    })
+}
