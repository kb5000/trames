 }
 #endif
+
+/* The current Trames profile selects one native Vulkan GPU per process.
+ * Register identity only after its original Zink screen initializes. No DRM
+ * or software extensions are claimed for this device; ordinary device handle
+ * validation, enumeration and display queries use the existing global lock.
+ */
+_EGLDevice *
+_eglFindNativeDevice(void)
+{
+   simple_mtx_lock(_eglGlobal.Mutex);
+   _EGLDevice *tail = _eglGlobal.DeviceList;
+   assert(tail);
+   while (tail->Next && tail != &native_device)
+      tail = tail->Next;
+   if (tail != &native_device)
+      tail->Next = &native_device;
+   simple_mtx_unlock(_eglGlobal.Mutex);
+   return &native_device;
+}
 
