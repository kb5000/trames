-   if (disp->Options.Zink) {
+   /* Native Vulkan WSI owns presentation images; no DRM FD or DMA-BUF
+    * transport is involved. Zink still validates the real Vulkan features.
+    * Leave the ordinary Wayland DRM initialization unchanged by default.
+    */
+   const bool native_wsi = disp->Options.Zink &&
+      debug_get_bool_option("LIBGL_KOPPER_WAYLAND_NO_DRM", false);
+   if (disp->Options.Zink && !native_wsi) {
       if (!dri2_initialize_wayland_drm_extensions(dri2_dpy) && !disp->Options.ForceSoftware)
          goto cleanup;
 
@@ -3082,7 +3088,12 @@
    if (!dri2_create_screen(disp))
       goto cleanup;
 
-   if (!dri2_setup_device(disp, disp->Options.ForceSoftware)) {
+   if (native_wsi && !disp->Options.ForceSoftware) {
+      /* A real Vulkan GPU without a DRM identity is neither a DRM nor a
+       * software EGLDevice. Publish an extension-free native device handle.
+       */
+      disp->Device = _eglFindNativeDevice();
+   } else if (!dri2_setup_device(disp, disp->Options.ForceSoftware)) {
       _eglError(EGL_NOT_INITIALIZED, "DRI2: failed to setup EGLDevice");
