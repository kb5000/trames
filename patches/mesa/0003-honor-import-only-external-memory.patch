+         zink_dmabuf_features(screen, VK_FORMAT_R8G8_UNORM) |
+         zink_dmabuf_features(screen, VK_FORMAT_B8G8R8A8_UNORM);
+      caps->dmabuf =
+         ((features & VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT) ? DRM_PRIME_CAP_IMPORT : 0) |
+         ((features & VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT) ? DRM_PRIME_CAP_EXPORT : 0);
