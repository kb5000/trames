Subject: Zink: honor import-only external memory profiles

--- a/src/gallium/drivers/zink/zink_screen.c
+++ b/src/gallium/drivers/zink/zink_screen.c
@@ -678,6 +678,36 @@
    caps->max_subgroups = screen->info.props13.maxComputeWorkgroupSubgroups;
 }
 
+/* Extension presence does not imply that a native image importer can also
+ * allocate/export generic device memory. Query the actual external profile. */
+static VkExternalMemoryFeatureFlags
+zink_dmabuf_features(struct zink_screen *screen, VkFormat format)
+{
+   if (!screen->info.have_EXT_external_memory_dma_buf ||
+       !VKSCR(GetPhysicalDeviceImageFormatProperties2))
+      return 0;
+   VkPhysicalDeviceExternalImageFormatInfo external = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+   };
+   VkPhysicalDeviceImageFormatInfo2 info = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2,
+      .pNext = &external,
+      .format = format, .type = VK_IMAGE_TYPE_2D,
+      .tiling = VK_IMAGE_TILING_LINEAR,
+      .usage = VK_IMAGE_USAGE_SAMPLED_BIT,
+   };
+   VkExternalImageFormatProperties external_props = {
+      .sType = VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES,
+   };
+   VkImageFormatProperties2 props = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2,
+      .pNext = &external_props,
+   };
+   return VKSCR(GetPhysicalDeviceImageFormatProperties2)(screen->pdev, &info, &props) == VK_SUCCESS
+      ? external_props.externalMemoryProperties.externalMemoryFeatures : 0;
+}
+
 static void
 zink_init_screen_caps(struct zink_screen *screen)
 {
@@ -732,6 +762,19 @@
       screen->instance_info->have_KHR_external_memory_capabilities &&
