+   if (caps->memobj && screen->info.have_KHR_external_memory_fd) {
+      VkPhysicalDeviceExternalBufferInfo info = {
+         .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_BUFFER_INFO,
+         .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT,
+         .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT,
+      };
+      VkExternalBufferProperties props = {
+         .sType = VK_STRUCTURE_TYPE_EXTERNAL_BUFFER_PROPERTIES,
+      };
+      VKSCR(GetPhysicalDeviceExternalBufferProperties)(screen->pdev, &info, &props);
+      caps->memobj = (props.externalMemoryProperties.externalMemoryFeatures &
+                     VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT) != 0;
+   }
    caps->fence_signal =
       screen->info.have_KHR_external_semaphore_fd ||
       screen->info.have_KHR_external_semaphore_win32;
@@ -1106,6 +1149,16 @@
 #else
