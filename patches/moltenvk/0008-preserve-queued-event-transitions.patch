 // Odd == set / Even == reset.
 bool MVKEventNative::isSet() { return _mtlEvent.signaledValue & 1; }
 
+// Encoding observes queued transitions, not only the GPU's completed value.
+// Otherwise set -> wait -> reset in one submission can omit the reset while
+// the first signal has not executed yet. Odd/even Metal values retain the
+// existing public event state; only this event's sequence metadata is atomic.
+uint64_t MVKEventNative::reserveSignal(bool status) {
+    uint64_t old = _signalValue.load(std::memory_order_relaxed);
+    for (;;) {
+        uint64_t value = std::max(old, _mtlEvent.signaledValue);
+        value += ((value & 1) != status);
+        if (_signalValue.compare_exchange_weak(old, value, std::memory_order_relaxed)) { return value; }
+    }
+}
